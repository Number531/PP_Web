{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/css/*", "/*.js", "/*.json", "/*.ico", "/*.svg"]
  },
  "routes": [
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "platform": {
    "apiRuntime": "node:18"
  },
  "buildProperties": {
    "outputLocation": ".next",
    "appLocation": "/"
  }
}
